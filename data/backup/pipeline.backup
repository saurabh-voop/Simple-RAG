# ------------------------------ full_rag_pipeline_improved.py ------------------------------

import json
import re
import os
import numpy as np
import faiss
from sentence_transformers import SentenceTransformer
from transformers import pipeline

# ------------------ Utilities ------------------

class DataProcessor:
    def __init__(self):
        self.kb = []

    def clean_text(self, text):
        text = re.sub(r'\s+', ' ', text)
        return text.strip()

    def chunk_text(self, text, size=200):
        words = text.split()
        chunks = []
        for i in range(0, len(words), size):
            chunk = " ".join(words[i:i + size])
            if len(chunk) > 80:
                chunks.append(chunk)
        return chunks

    def process(self, input_file):
        base_dir = os.path.dirname(os.path.abspath(__file__))
        project_dir = os.path.dirname(base_dir)
        input_file = os.path.join(project_dir, input_file)

        with open(input_file, "r", encoding="utf-8") as f:
            data = json.load(f)

        chunk_id = 0
        for item in data:
            text = self.clean_text(item.get("text", ""))
            if len(text) < 80:
                continue

            for chunk in self.chunk_text(text):
                self.kb.append({
                    "id": f"chunk_{chunk_id}",
                    "loan_name": item.get("loan_name", "Unknown Loan"),
                    "section": item.get("section", "General"),
                    "text": chunk,
                    "source_url": item.get("source_url", ""),
                })
                chunk_id += 1

        print(f"[INFO] Created {len(self.kb)} chunks from {len(data)} records")
        return self.kb

    def save(self, output_file):
        base_dir = os.path.dirname(os.path.abspath(__file__))
        project_dir = os.path.dirname(base_dir)
        output_file = os.path.join(project_dir, output_file)

        with open(output_file, "w", encoding="utf-8") as f:
            json.dump(self.kb, f, indent=2, ensure_ascii=False)

        print(f"[INFO] Knowledge base saved: {output_file}")


# ------------------ Phase 2: Strong Retrieval ------------------

class Retriever:
    def __init__(self, kb_file):
        base_dir = os.path.dirname(os.path.abspath(__file__))
        project_dir = os.path.dirname(base_dir)
        kb_file = os.path.join(project_dir, kb_file)

        with open(kb_file, "r", encoding="utf-8") as f:
            self.kb = json.load(f)

        self.texts = [item["text"] for item in self.kb]

        self.model = SentenceTransformer("all-MiniLM-L6-v2")

        print("[INFO] Encoding KB embeddings...")
        embeddings = self.model.encode(
            self.texts,
            show_progress_bar=True,
            normalize_embeddings=True
        )

        self.embeddings = np.array(embeddings).astype("float32")

        dim = self.embeddings.shape[1]
        self.index = faiss.IndexFlatIP(dim)  # cosine similarity
        self.index.add(self.embeddings)

        print(f"[INFO] Indexed {self.index.ntotal} chunks")

    def enhance_query(self, query):
        return f"{query}. Provide details, eligibility, documents, interest rate."

    def search(self, query, top_k=8, min_score=0.25):
        enhanced_query = self.enhance_query(query)

        query_emb = self.model.encode(
            [enhanced_query],
            normalize_embeddings=True
        ).astype("float32")

        scores, indices = self.index.search(query_emb, top_k)

        results = []
        for score, idx in zip(scores[0], indices[0]):
            if score < min_score:
                continue

            item = self.kb[idx]
            results.append({
                "loan_name": item["loan_name"],
                "section": item["section"],
                "text": item["text"],
                "source_url": item["source_url"],
                "score": float(score)
            })

        return results


# ------------------ Phase 3: Answer Generation ------------------

class AnswerGenerator:
    def __init__(self):
        self.generator = pipeline(
            "text2text-generation",
            model="google/flan-t5-base"
        )

    def generate(self, query, chunks):
        context = "\n\n".join(
            f"[{c['loan_name']} | {c['section']}]\n{c['text']}"
            for c in chunks
        )

        prompt = f"""
Answer the question strictly using the context.
If information is missing, say "Information not available".

Context:
{context}

Question:
{query}

Answer:
"""

        output = self.generator(
            prompt,
            max_length=350,
            do_sample=False
        )

        return output[0]["generated_text"]


# ------------------ MAIN ------------------

if __name__ == "__main__":

    raw_file = "data/raw_loan_data-1.json"
    kb_file = "data/knowledge_base-200.json"

    processor = DataProcessor()
    processor.process(raw_file)
    processor.save(kb_file)

    retriever = Retriever(kb_file)
    generator = AnswerGenerator()

    queries = [
        "Documents required for gold loan",
        "Interest rate for home loan",
        "Eligibility for education loan",
        "Processing fees for car loan"
    ]

    for q in queries:
        print("\n" + "=" * 90)
        print(f"QUERY: {q}")

        retrieved = retriever.search(q)

        if not retrieved:
            print("[INFO] No relevant chunks found")
            continue

        for r in retrieved:
            print(f"\n[{r['loan_name']} | {r['section']}]  Score: {r['score']:.3f}")
            print(r["text"][:300] + "...")
            print(f"Source: {r['source_url']}")

        answer = generator.generate(q, retrieved)
        print("\n[FINAL ANSWER]")
        print(answer)
