import json
import re
import hashlib
import os


class DataProcessor:
    def __init__(self, chunk_size=350):
        self.chunk_size = chunk_size
        self.kb = []
        self.seen_hashes = set()

    # ------------------ Utilities ------------------

    def clean_text(self, text):
        text = re.sub(r'\s+', ' ', text)
        return text.strip()

    def hash_text(self, text):
        return hashlib.sha256(text.lower().encode("utf-8")).hexdigest()

    # ------------------ Chunking ------------------

    def chunk_text(self, text):
        words = text.split()
        chunks = []

        for i in range(0, len(words), self.chunk_size):
            chunk_words = words[i:i + self.chunk_size]
            chunk_text = " ".join(chunk_words)

            if len(chunk_text) >= 80:
                chunks.append(chunk_text)

        return chunks

    # ------------------ Core Processing ------------------

    def process(self, input_file):
        with open(input_file, "r", encoding="utf-8") as f:
            data = json.load(f)

        grouped = {}

        # -------- Group by loan + section --------
        for item in data:
            loan = item.get("loan_name", "Unknown Loan")
            section = item.get("section", "General")
            text = self.clean_text(item.get("text", ""))

            if len(text) < 30:
                continue

            # Merge link into text (IMPORTANT)
            if "link_url" in item:
                text = f"{text} (Link: {item['link_url']})"

            key = (loan, section)
            grouped.setdefault(key, [])
            grouped[key].append(text)

        # -------- Deduplicate + Chunk --------
        chunk_id = 0

        for (loan, section), texts in grouped.items():
            combined = self.clean_text(" ".join(texts))
            chunks = self.chunk_text(combined)

            for chunk in chunks:
                h = self.hash_text(chunk)
                if h in self.seen_hashes:
                    continue

                self.seen_hashes.add(h)

                self.kb.append({
                    "id": f"{loan.lower().replace(' ', '_')}_{section.lower().replace(' ', '_')}_{chunk_id}",
                    "loan_name": loan,
                    "section": section,
                    "chunk": chunk,
                    "tokens": len(chunk.split())
                })

                chunk_id += 1

        print(f"[DONE] Created {len(self.kb)} RAG-ready chunks from {len(data)} raw records")
        return self.kb

    # ------------------ Save ------------------

    def save(self, output_file):
        base_dir = os.path.dirname(os.path.abspath(__file__))
        project_root = os.path.dirname(base_dir)
        filepath = os.path.join(project_root, output_file)

        os.makedirs(os.path.dirname(filepath), exist_ok=True)
        with open(filepath, "w", encoding="utf-8") as f:
            json.dump(self.kb, f, indent=2, ensure_ascii=False)

        print(f"[SAVED] Knowledge base → {filepath}")


# ------------------ MAIN ------------------

if __name__ == "__main__":
    processor = DataProcessor(chunk_size=350)
    processor.process("data/raw_loan_data-1.json")
    processor.save("data/knowledge_base.json")

